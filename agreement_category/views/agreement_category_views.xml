<odoo>
    <record id="view_agreement_category_list" model="ir.ui.view">
        <field name="name">agreement.category.list</field>
        <field name="model">agreement.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field name="color" widget="color_picker" />
            </list>
        </field>
    </record>

    <record id="view_agreement_category_form" model="ir.ui.view">
        <field name="name">agreement.category.form</field>
        <field name="model">agreement.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="color" widget="color_picker" />
                        <field name="active" invisible="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_agreement_category" model="ir.actions.act_window">
        <field name="name">Agreement Categories</field>
        <field name="res_model">agreement.category</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem
        id="agreement_category_menu"
        name="Tags"
        parent="agreement.agreement_setting_menu"
        groups="agreement.group_agreement_manager"
        action="action_agreement_category"
        sequence="40"
    />
</odoo>
