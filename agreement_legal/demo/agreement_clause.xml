        <field name="agreement_id" ref="agreement.market2" />
        <field name="section_id" ref="agreement_section_market2_terms" />
    </record>

    <record id="agreement_clause_market6_template_warranty" model="agreement.clause">
        <field name="name">Warranty</field>
        <field name="title">1.1 Warranty</field>
        <field name="sequence">10</field>
