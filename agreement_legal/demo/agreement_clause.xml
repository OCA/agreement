<odoo noupdate="1">
    <record id="agreement_clause_market1_scope_delivery" model="agreement.clause">
        <field name="name">Delivery</field>
        <field name="title">1.1 Delivery</field>
        <field name="sequence">10</field>
        <field
            name="content"
        ><![CDATA[<p>The Supplier shall deliver hardware IT equipment within thirty (30) days of order confirmation.</p>]]></field>
        <field name="agreement_id" ref="agreement.market1" />
        <field name="section_id" ref="agreement_section_market1_scope" />
    </record>

    <record id="agreement_clause_market1_payment_invoicing" model="agreement.clause">
        <field name="name">Invoicing</field>
        <field name="title">2.1 Invoicing</field>
        <field name="sequence">10</field>
        <field
            name="content"
        ><![CDATA[<p>Invoices shall be payable within thirty (30) days of receipt.</p>]]></field>
        <field name="agreement_id" ref="agreement.market1" />
        <field name="section_id" ref="agreement_section_market1_payment" />
    </record>

    <record id="agreement_clause_market2_terms_sla" model="agreement.clause">
        <field name="name">Service Level</field>
        <field name="title">1.1 Service Level</field>
        <field name="sequence">10</field>
        <field
            name="content"
