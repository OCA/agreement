<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <t
        t-name="agreement_legal.ListViewButtons"
        t-inherit="web.ListView.Buttons"
        t-inherit-mode="primary"
    >
        <xpath expr="//button[hasclass('o_list_button_add')]" position="attributes">
            <attribute
                name="t-if"
            >!this.env.inDialog and !this.editedRecord and this.activeActions.create and this.canCreateTemplate</attribute>
        </xpath>
        <xpath expr="//button[hasclass('o_list_button_add')]" position="after">
            <t
                t-if="!this.env.inDialog and !this.editedRecord and this.activeActions.create and !this.canCreateTemplate"
            >
                <t t-call="agreement_legal.TemplateButton" />
            </t>
        </xpath>
    </t>
</templates>
