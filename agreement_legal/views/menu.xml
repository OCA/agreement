<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Hide base agreement app menu; restored by uninstall_hook. -->
    <record id="agreement.agreement_menu_root" model="ir.ui.menu">
        <field name="active" eval="False" />
    </record>

    <!-- Top menu item -->
    <menuitem
        id="agreement_legal_menu_root"
        name="Agreements"
        web_icon="agreement_legal,static/description/icon.png"
        sequence="80"
        action="agreement_legal.agreement_dashboard_agreement"
    />
    <!-- Dashboard -->
    <menuitem
        id="agreement_dashboard"
        name="Dashboard"
        parent="agreement_legal_menu_root"
        sequence="10"
    />
    <menuitem
        id="dashboard_agreements"
        name="Agreements"
        parent="agreement_dashboard"
        sequence="10"
        action="agreement_legal.agreement_dashboard_agreement"
    />

    <!-- Operations -->
    <menuitem
        id="agreement_operations"
        name="Operations"
        parent="agreement_legal_menu_root"
        sequence="20"
    />
    <menuitem
        id="operations_agreements"
        name="Agreements"
        parent="agreement_operations"
        sequence="10"
        action="agreement_operations_agreement"
    />

    <!-- Master Data -->
    <menuitem
        id="agreement_masterdata"
        name="Master Data"
        parent="agreement_legal_menu_root"
        sequence="30"
    />
    <menuitem
        id="agreement_data_contents"
        name="Contents"
        parent="agreement_masterdata"
        sequence="10"
    />
    <menuitem
        id="agreement_recitals"
        name="Recitals"
        parent="agreement_data_contents"
        sequence="10"
        action="agreement_recital_action"
    />
    <menuitem
        id="agreement_clauses"
        name="Clauses"
        parent="agreement_data_contents"
        sequence="20"
        action="partner_agreement_action_clause"
    />
    <menuitem
        id="agreement_sections"
        name="Sections"
        parent="agreement_data_contents"
        sequence="30"
        action="partner_agreement_action_section"
    />
    <menuitem
        id="agreement_appendices"
        name="Appendices"
        parent="agreement_data_contents"
        sequence="40"
        action="agreement_appendix_action"
    />
    <menuitem
        id="agreement_products"
        name="Products"
        sequence="100"
        parent="agreement_masterdata"
        action="product.product_template_action"
    />

    <!-- Reporting -->
    <menuitem
        id="agreement_reporting"
        name="Reporting"
        sequence="40"
        parent="agreement_legal_menu_root"
        groups="agreement.group_agreement_manager"
    />

    <menuitem
        id="agreement_agreement_reporting"
        name="Agreements"
        sequence="10"
        parent="agreement_reporting"
        action="action_agreement_report_order"
    />

    <!-- Configuration -->
    <menuitem
        id="agreement_configuration"
        name="Configuration"
        sequence="50"
        parent="agreement_legal_menu_root"
        groups="agreement.group_agreement_manager"
    />
    <menuitem
        id="agreement_settings"
        name="Settings"
        sequence="10"
        parent="agreement_configuration"
        action="agreement_legal.action_agreement_config"
    />
    <menuitem
        id="template"
        name="Templates"
        parent="agreement_configuration"
        sequence="20"
        action="partner_agreement_agreement_templates"
    />
    <menuitem
        id="agreement_stages"
        name="Stages"
        parent="agreement_configuration"
        sequence="30"
        action="partner_agreement_action_stage"
    />
    <menuitem
        id="agreement_types"
        name="Types"
        parent="agreement_configuration"
        sequence="40"
        action="partner_agreement_action_type"
    />
    <menuitem
        id="agreement_subtypes"
        name="Sub-Types"
        parent="agreement_configuration"
        sequence="50"
        action="partner_agreement_action_subtype"
    />
</odoo>
